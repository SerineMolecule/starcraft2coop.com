                            ]
                        }
                    },
                    "required": [
                        "commander",
                        "effect",
                        "icon",
                        "modifier",
                        "modifiermode",
                        "modifiertag",
                        "name",
                        "operation",
                        "unit",
                        "upgradeid",
                        "upgradetype",
                        "value"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "modifier": {
                            "type": "null"
                        },
                        "modifiertag": {
                            "type": "null"
                        },
                        "value": {
                            "type": "null"
                        },
                        "operation": {
                            "type": "string",
                            "const": "none",
                            "description": "No direct unit-stat effect. Informational unless skillModifiers or unlocksModes supplies an effect."
                        },
                        "upgradeid": {
