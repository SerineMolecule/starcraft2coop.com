{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/PlayerUpgradeList",
    "definitions": {
        "PlayerUpgradeList": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/PlayerUpgrade"
            }
        },
        "PlayerUpgrade": {
            "anyOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "modifier": {
                            "type": "string"
                        },
                        "modifiertag": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "which target tag does it apply to? (e.g. vs. Armored)"
                        },
                        "value": {
                            "type": "number"
                        },
                        "operation": {
                            "type": "string",
                            "enum": [
                                "add",
                                "set",
                                "multiply"
                            ]
                        },
                        "upgradeid": {
                            "$ref": "#/definitions/PositiveInteger"
                        },
                        "unit": {
                            "type": "string"
                        },
                        "commander": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "icon": {
                            "type": "string"
                        },
                        "temporary": {
                            "type": "boolean",
                            "description": "Applies an active temporary effect rather than permanent research. Omitted means false."
                        },
                        "cost": {
                            "$ref": "#/definitions/ResourceCost",
                            "description": "Purchase/research cost before optional mastery or prestige modifiers. Omit for free unlocks and effects without a purchase."
                        },
                        "researchTime": {
                            "$ref": "#/definitions/NonNegativeInteger",
                            "description": "Base research duration in game seconds. Omit for instant purchases and non-researched unlocks."
                        },
                        "buildTimeIsAdditional": {
                            "type": "boolean",
                            "description": "Selecting this upgrade makes the unit's displayed build time an additional installation/morph time."
                        },
                        "rank": {
                            "type": "number",
                            "enum": [
                                1,
                                2,
                                3
                            ],
                            "description": "Royal Guard rank that unlocks this named ability."
                        },
                        "effect": {
                            "type": "string"
                        },
                        "skillModifiers": {
                            "type": "array",
                            "items": {
                                "anyOf": [
                                    {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {
                                            "skill": {
                                                "type": "string"
                                            },
                                            "skillMode": {
                                                "type": "string"
                                            },
                                            "modifier": {
                                                "type": "string",
                                                "pattern": "^(cooldown|initialCooldown|energycost|charges|values\\..+)$"
                                            },
                                            "operation": {
                                                "type": "string",
                                                "enum": [
                                                    "add",
                                                    "multiply",
                                                    "set"
                                                ]
                                            },
                                            "value": {
                                                "type": "number"
                                            }
                                        },
                                        "required": [
                                            "modifier",
                                            "operation",
                                            "skill",
                                            "value"
                                        ]
                                    },
                                    {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {
                                            "skill": {
                                                "type": "string"
                                            },
                                            "skillMode": {
                                                "type": "string"
                                            },
                                            "modifier": {
                                                "type": "string",
                                                "pattern": "^(description|requirements|cooldown|initialCooldown|energycost|values\\..+)$"
                                            },
                                            "operation": {
                                                "type": "string",
                                                "const": "replace"
                                            },
                                            "value": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "modifier",
                                            "operation",
                                            "skill",
                                            "value"
                                        ]
                                    }
                                ]
                            },
                            "description": "Changes to this unit's skills, applied by the same upgrade checkbox as its unit-stat effect. Unlock-only research stays informational: skills remain listed with their prerequisites."
                        },
                        "unlocksModes": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Mode/attack keys on this unit enabled by selecting this upgrade in the new Units UI."
                        },
                        "weapon": {
                            "type": "string",
                            "description": "Mode/attack key for an upgrade affecting one entry; an empty string selects the default. Omitted applies to all eligible attacks."
                        },
                        "modifiermode": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "Mode label for form-specific unit stat changes (e.g. Siege Mode)."
                        },
                        "upgradetype": {
                            "type": "string",
                            "enum": [
                                "preupgrade",
                                "upgrade"
                            ]
                        }
                    },
                    "required": [
                        "commander",
                        "effect",
                        "icon",
                        "modifier",
                        "modifiermode",
                        "modifiertag",
                        "name",
                        "operation",
                        "unit",
                        "upgradeid",
                        "upgradetype",
                        "value"
                    ]
                },
