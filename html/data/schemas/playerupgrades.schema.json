        },
        "PositiveInteger": {
            "type": "integer",
            "minimum": 1
        },
        "ResourceCost": {
            "type": "object",
            "properties": {
                "minerals": {
                    "$ref": "#/definitions/NonNegativeInteger"
                },
                "gas": {
                    "$ref": "#/definitions/NonNegativeInteger"
                },
                "supply": {
                    "$ref": "#/definitions/NonNegativeInteger"
                }
            },
            "required": [
                "minerals",
                "gas"
            ],
            "additionalProperties": false
        },
        "NonNegativeInteger": {
            "type": "integer",
            "minimum": 0
        }
