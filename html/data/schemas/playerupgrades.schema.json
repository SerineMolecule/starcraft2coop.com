{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/PlayerUpgradeList",
    "definitions": {
        "PlayerUpgradeList": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/PlayerUpgrade"
            }
        },
        "PlayerUpgrade": {
            "anyOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "modifier": {
                            "type": "string"
                        },
                        "modifiertag": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "which target tag does it apply to? (e.g. vs. Armored)"
                        },
                        "value": {
                            "type": "number"
                        },
                        "operation": {
                            "type": "string",
                            "enum": [
                                "add",
                                "set",
                                "multiply"
                            ]
                        },
                        "upgradeid": {
                            "$ref": "#/definitions/PositiveInteger"
                        },
                        "unit": {
                            "type": "string"
                        },
                        "commander": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "icon": {
                            "type": "string"
                        },
                        "temporary": {
                            "type": "boolean",
                            "description": "Applies an active temporary effect rather than permanent research. Omitted means false."
                        },
                        "rank": {
                            "type": "number",
                            "enum": [
                                1,
                                2,
                                3
                            ],
                            "description": "Royal Guard rank that unlocks this named ability."
                        },
                        "effect": {
                            "type": "string"
                        },
                        "modifiermode": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "which mode does it apply to? (e.g. Siege Mode)"
                        },
                        "upgradetype": {
                            "type": "string",
                            "enum": [
                                "preupgrade",
                                "upgrade"
                            ]
                        }
                    },
                    "required": [
                        "commander",
                        "effect",
                        "icon",
                        "modifier",
                        "modifiermode",
                        "modifiertag",
                        "name",
                        "operation",
                        "unit",
                        "upgradeid",
                        "upgradetype",
                        "value"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "modifier": {
                            "type": "string",
                            "const": "aoe"
                        },
                        "modifiertag": {
                            "type": "null"
                        },
                        "value": {
                            "type": "string",
                            "description": "Replaces the entire plain-text description, rather than matching a substring."
                        },
                        "operation": {
                            "type": "string",
                            "const": "replace"
                        },
                        "upgradeid": {
                            "$ref": "#/definitions/PositiveInteger"
                        },
                        "unit": {
                            "type": "string"
                        },
                        "commander": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "icon": {
                            "type": "string"
                        },
                        "temporary": {
                            "type": "boolean",
                            "description": "Applies an active temporary effect rather than permanent research. Omitted means false."
                        },
                        "rank": {
                            "type": "number",
                            "enum": [
                                1,
                                2,
                                3
                            ],
                            "description": "Royal Guard rank that unlocks this named ability."
                        },
                        "effect": {
                            "type": "string"
                        },
                        "modifiermode": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "which mode does it apply to? (e.g. Siege Mode)"
                        },
                        "upgradetype": {
                            "type": "string",
                            "enum": [
                                "preupgrade",
                                "upgrade"
                            ]
                        }
                    },
                    "required": [
                        "commander",
                        "effect",
                        "icon",
                        "modifier",
                        "modifiermode",
                        "modifiertag",
                        "name",
                        "operation",
                        "unit",
                        "upgradeid",
                        "upgradetype",
                        "value"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "modifier": {
                            "type": "null"
                        },
                        "modifiertag": {
                            "type": "null"
                        },
                        "value": {
                            "type": "null"
                        },
                        "operation": {
                            "type": "string",
                            "const": "none",
                            "description": "Informational upgrade with no effect on the displayed stats."
                        },
                        "upgradeid": {
                            "$ref": "#/definitions/PositiveInteger"
                        },
                        "unit": {
                            "type": "string"
                        },
                        "commander": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "icon": {
                            "type": "string"
                        },
                        "temporary": {
                            "type": "boolean",
                            "description": "Applies an active temporary effect rather than permanent research. Omitted means false."
                        },
                        "rank": {
                            "type": "number",
                            "enum": [
                                1,
                                2,
                                3
                            ],
                            "description": "Royal Guard rank that unlocks this named ability."
                        },
                        "effect": {
                            "type": "string"
                        },
                        "modifiermode": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "description": "which mode does it apply to? (e.g. Siege Mode)"
                        },
                        "upgradetype": {
                            "type": "string",
                            "enum": [
                                "preupgrade",
                                "upgrade"
                            ]
                        }
                    },
                    "required": [
                        "commander",
                        "effect",
                        "icon",
                        "modifier",
                        "modifiermode",
                        "modifiertag",
                        "name",
                        "operation",
                        "unit",
                        "upgradeid",
                        "upgradetype",
                        "value"
                    ]
                }
            ]
        },
        "PositiveInteger": {
            "type": "integer",
            "minimum": 1
        }
    }
}
