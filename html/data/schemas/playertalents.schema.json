{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$ref": "#/definitions/PlayerTalentList",
    "definitions": {
        "PlayerTalentList": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/PlayerTalent"
            }
        },
        "PlayerTalent": {
            "anyOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "talenttype": {
                            "type": "string",
                            "const": "mastery"
                        },
                        "changes": {
                            "type": "array",
                            "items": {
                                "anyOf": [
                                    {
                                        "type": "object",
                                        "properties": {
                                            "modifier": {
                                                "type": "string"
                                            },
                                            "modifierupgrade": {
                                                "type": "string",
                                                "description": "Which upgrade needs to be enabled for this change to have an effect?"
                                            },
                                            "extra": {
                                                "type": "string"
                                            },
                                            "value": {
                                                "type": "number"
                                            },
                                            "operation": {
                                                "type": "string",
                                                "enum": [
                                                    "add",
                                                    "set",
                                                    "multiply"
                                                ]
                                            },
                                            "operationtype": {
                                                "type": "string",
                                                "enum": [
                                                    "increase",
                                                    "decrease"
                                                ]
                                            },
                                            "target": {
                                                "type": "string",
                                                "enum": [
                                                    "unit",
                                                    "upgrade"
                                                ]
                                            }
                                        },
                                        "required": [
                                            "modifier",
                                            "value",
                                            "operation",
                                            "target"
                                        ],
                                        "additionalProperties": false
                                    },
                                    {
                                        "$ref": "#/definitions/PlayerSkillTalentChange"
                                    }
                                ]
                            },
                            "minItems": 1
                        },
                        "talentid": {
                            "$ref": "#/definitions/PositiveInteger"
                        },
                        "units": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Units receiving this exact definition, in this commander.",
                            "minItems": 1,
                            "uniqueItems": true
                        },
                        "commander": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "nameid": {
                            "type": "string"
                        },
                        "temporary": {
                            "type": "boolean",
                            "description": "Directly applies a temporary effect. Omitted means false."
                        }
                    },
                    "required": [
                        "changes",
                        "commander",
                        "name",
                        "nameid",
                        "talentid",
                        "talenttype",
                        "units"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "talenttype": {
                            "type": "string",
                            "enum": [
                                "prestige",
                                "post"
                            ]
                        },
                        "changes": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/PlayerTalentChange"
                            },
                            "minItems": 1
                        },
                        "talentid": {
                            "$ref": "#/definitions/PositiveInteger"
                        },
                        "units": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Units receiving this exact definition, in this commander.",
                            "minItems": 1,
                            "uniqueItems": true
                        },
                        "commander": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "nameid": {
                            "type": "string"
                        },
                        "temporary": {
                            "type": "boolean",
                            "description": "Directly applies a temporary effect. Omitted means false."
                        }
                    },
                    "required": [
                        "changes",
                        "commander",
                        "name",
                        "nameid",
                        "talentid",
                        "talenttype",
                        "units"
                    ]
                }
            ],
            "description": "A named talent shared by one commander's units. Omitted selectors impose no restriction. operationtype is required for mastery multipliers; ordinary multipliers omit it. Changes are applied in array order within the existing mastery/prestige/post phase; unit, upgrade, and skill changes may coexist. Definitions may differ between units. html/data/legacy/playertalents.json expands these for the legacy PHP calculator."
        },
        "PlayerSkillTalentChange": {
            "anyOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "target": {
                            "type": "string",
                            "const": "skill"
                        },
                        "skill": {
                            "type": "string"
                        },
                        "skillMode": {
                            "type": "string",
                            "description": "Restrict to a named skill mode; omitted applies to every matching mode."
                        },
                        "operationtype": {
                            "type": "string",
                            "enum": [
                                "increase",
                                "decrease"
                            ]
                        },
                        "modifier": {
                            "type": "string",
                            "pattern": "^(cooldown|initialCooldown|energycost|charges|values\\..+)$"
                        },
                        "operation": {
                            "type": "string",
                            "enum": [
                                "add",
                                "multiply",
                                "set"
                            ]
                        },
                        "value": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "modifier",
                        "operation",
                        "skill",
                        "target",
                        "value"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "target": {
                            "type": "string",
                            "const": "skill"
                        },
                        "skill": {
                            "type": "string"
                        },
                        "skillMode": {
                            "type": "string",
                            "description": "Restrict to a named skill mode; omitted applies to every matching mode."
                        },
                        "operationtype": {
                            "type": "string",
                            "enum": [
                                "increase",
                                "decrease"
                            ]
                        },
                        "modifier": {
                            "type": "string",
                            "pattern": "^(description|requirements|cooldown|initialCooldown|energycost|values\\..+)$"
                        },
                        "operation": {
                            "type": "string",
                            "const": "replace"
                        },
                        "value": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "modifier",
                        "operation",
                        "skill",
                        "target",
                        "value"
                    ]
                }
            ],
            "description": "Add/multiply require a numeric current value; set and replace overwrite it. Text replacements replace the whole field. Skill availability stays in UnitSkill."
        },
        "PositiveInteger": {
            "type": "integer",
            "minimum": 1
        },
        "PlayerTalentChange": {
            "anyOf": [
                {
                    "$ref": "#/definitions/PlayerUnitTalentChange"
                },
                {
                    "$ref": "#/definitions/PlayerSkillTalentChange"
                }
            ]
        },
        "PlayerUnitTalentChange": {
            "anyOf": [
                {
                    "type": "object",
                    "properties": {
                        "modifier": {
                            "type": "string"
                        },
                        "modifierupgrade": {
                            "type": "string",
                            "description": "Which upgrade needs to be enabled for this change to have an effect?"
                        },
                        "extra": {
                            "type": "string"
                        },
                        "value": {
                            "type": "number"
                        },
                        "operation": {
                            "type": "string",
                            "enum": [
                                "add",
                                "set",
                                "multiply"
                            ]
                        },
                        "operationtype": {
                            "type": "string",
                            "enum": [
                                "increase",
                                "decrease"
                            ]
                        },
                        "target": {
                            "type": "string",
                            "enum": [
                                "unit",
                                "upgrade"
                            ]
                        }
                    },
                    "required": [
                        "modifier",
                        "value",
                        "operation",
                        "target"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "modifier": {
                            "type": "string",
                            "enum": [
                                "aoe",
                                "weaponName"
                            ]
                        },
                        "operation": {
                            "type": "string",
                            "const": "replace"
                        },
                        "value": {
                            "type": "string"
                        },
                        "weapon": {
                            "type": "string",
                            "description": "Mode/attack key; omitted applies to all attacks."
                        },
                        "target": {
                            "type": "string",
                            "const": "unit"
                        }
                    },
                    "required": [
                        "modifier",
                        "operation",
                        "value",
                        "target"
                    ],
                    "additionalProperties": false
                }
            ]
        }
    }
}
